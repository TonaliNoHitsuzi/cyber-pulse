{
  "_说明": "课堂演示常用命令配置。字段：g=分组, l=显示名, c=命令；多条命令用分号分隔会顺序下发。讲课前按需增删改名，保存后刷新网页即生效（无需重启桥）。灯效 fx 0~7 的具体名字可以自己改。",
  "commands": [
    {"g": "演示", "l": "⚡ 一键演示配置", "c": "raw 1; dbg 1; dump 0"},
    {"g": "演示", "l": "安静模式(收数据用)", "c": "raw 0; dbg 0; dump 0"},
    {"g": "演示", "l": "保存配置到NVS", "c": "save"},
    {"g": "演示", "l": "查询当前配置", "c": "?"},
    {"g": "演示", "l": "唤醒设备(输出静默时)", "c": "rec wake"},

    {"g": "灯效", "l": "彩虹", "c": "fx 1"},
    {"g": "灯效", "l": "停止", "c": "fx 0"},
    {"g": "灯效", "l": "灯效2", "c": "fx 2"},
    {"g": "灯效", "l": "灯效3", "c": "fx 3"},
    {"g": "灯效", "l": "灯效5", "c": "fx 5"},
    {"g": "灯效", "l": "灯效7", "c": "fx 7"},
    {"g": "灯效", "l": "亮度30", "c": "led 30"},
    {"g": "灯效", "l": "亮度60", "c": "led 60"},

    {"g": "算法", "l": "峰阈值40", "c": "thr 40"},
    {"g": "算法", "l": "峰阈值50", "c": "thr 50"},
    {"g": "算法", "l": "不应期350ms", "c": "gap 350"},
    {"g": "算法", "l": "不应期300ms", "c": "gap 300"},
    {"g": "算法", "l": "质量门默认", "c": "q 18 45"},
    {"g": "算法", "l": "配对i+1(上限171)", "c": "pair 1"},
    {"g": "算法", "l": "配对i+2(上限86)", "c": "pair 2"},
    {"g": "算法", "l": "保守度40", "c": "cons 40"},
    {"g": "算法", "l": "保守度70", "c": "cons 70"},

    {"g": "采集", "l": "开始闪存采集", "c": "rec start"},
    {"g": "采集", "l": "停止采集", "c": "rec stop"},
    {"g": "采集", "l": "采集列表", "c": "rec list"},
    {"g": "采集", "l": "擦除闪存", "c": "rec erase"},

    {"g": "BLE", "l": "开波形推送", "c": "wave 1"},
    {"g": "BLE", "l": "关波形推送", "c": "wave 0"}
  ]
}
