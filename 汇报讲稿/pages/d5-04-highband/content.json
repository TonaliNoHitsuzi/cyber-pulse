nt-size=\"11.5\" fill=\"#94a3b8\">频率（Hz）</text>\n<text x=\"56\" y=\"200\" text-anchor=\"middle\" font-size=\"11.5\" fill=\"#94a3b8\" transform=\"rotate(-90 56 200)\">功率（相对）</text>\n<line x1=\"124.0\" y1=\"335\" x2=\"124.0\" y2=\"230.6\" stroke=\"#1d4ed8\" stroke-width=\"1.5\" opacity=\".85\"/><line x1=\"178.5\" y1=\"335\" x2=\"178.5\" y2=\"253.8\" stroke=\"#1d4ed8\" stroke-width=\"1.5\" opacity=\".85\"/><line x1=\"233.0\" y1=\"335\" x2=\"233.0\" y2=\"271.2\" stroke=\"#1d4ed8\" stroke-width=\"1.5\" opacity=\".85\"/><line x1=\"287.5\" y1=\"335\" x2=\"287.5\" y2=\"285.7\" stroke=\"#1d4ed8\" stroke-width=\"1.5\" opacity=\".85\"/><line x1=\"342.0\" y1=\"335\" x2=\"342.0\" y2=\"297.3\" stroke=\"#1d4ed8\" stroke-width=\"1.5\" opacity=\".85\"/><g font-size=\"10.5\" fill=\"#64748b\">\n<line x1=\"436\" y1=\"252\" x2=\"454\" y2=\"252\" stroke=\"#334155\" stroke-width=\"2.2\"/>\n<text x=\"460\" y=\"256\">步态 ÷ 2</text>\n<line x1=\"436\" y1=\"274\" x2=\"454\" y2=\"274\" stroke=\"#1d4ed8\" stroke-width=\"1.8\" opacity=\".85\"/>\n<text x=\"460\" y=\"278\">脉搏（示意）</text>\n</g></svg></div>",
